{
    "name": "@repo/svelte",
    "type": "module",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "build": "vite build",
        "check": "pnpm lint && pnpm typecheck",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "dev": "vite dev",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "pnpm run types && svelte-kit sync || echo ''",
        "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js",
        "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "types": "wrangler types"
    },
    "devDependencies": {
        "@antfu/eslint-config": "catalog:",
        "@sveltejs/adapter-cloudflare": "catalog:",
        "@sveltejs/kit": "catalog:",
        "@sveltejs/vite-plugin-svelte": "catalog:",
        "@tailwindcss/vite": "catalog:",
        "@types/node": "catalog:",
        "eslint": "catalog:",
        "eslint-plugin-better-tailwindcss": "catalog:",
        "eslint-plugin-svelte": "catalog:",
        "globals": "catalog:",
        "svelte": "catalog:",
        "svelte-check": "catalog:",
        "tailwindcss": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "catalog:",
        "vite": "catalog:",
        "vite-plugin-devtools-json": "catalog:",
        "wrangler": "catalog:"
    }
}
